{
  "name": "toolshop-checkout-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E suite for the Practice Software Testing (Toolshop) checkout flow",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
